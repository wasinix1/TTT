# Template. deploy/apply-domains.sh fills in the site names from domains.conf and
# adds any redirects at the bottom. Don't edit /etc/caddy/Caddyfile on the
# server by hand; the next deploy would overwrite it.
# Caddy gets and renews the TLS certificate for every name on its own.

__SITES__ {
	encode zstd gzip

	# Server-sent events must not be buffered or the live updates arrive
	# in batches whenever the proxy decides to flush.
	@sse path /api/stream
	reverse_proxy @sse 127.0.0.1:8000 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:8000
}
